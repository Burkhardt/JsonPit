<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Title>JsonPit</Title>
		<PackageId>JsonPit</PackageId>
		<Version>4.2.6</Version>
		<Authors>Rainer Burkhardt</Authors>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>Stores json files across servers (synchronized).</Description>
		<TargetFramework>net10.0</TargetFramework>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageTags>Json, cross-server synchronized</PackageTags>
		<IsPackable>true</IsPackable>
		<ProjectURL>https://github.com/Burkhardt/JsonPit</ProjectURL>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<Copyright>© Rainer Burkhardt. All rights reserved.</Copyright>
		<RepositoryUrl>https://github.com/Burkhardt/JsonPit</RepositoryUrl>
		<RepositoryType>github</RepositoryType>
		<PackageReleaseNotes>4.2.6 coordinated dependency release for accepted CR019.</PackageReleaseNotes>
		<PackageIcon>HardCastle.png</PackageIcon>
		<DefaultItemExcludes>$(DefaultItemExcludes);JsonPit.Tests\**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Jil" Version="2.17.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Sigil" Version="5.0.0" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="HardCastle.png" Pack="true" PackagePath="" />
	</ItemGroup>

	<PropertyGroup>
		<RAIkeepRoot Condition="'$(RAIkeepRoot)' == '' and Exists('../OsLib/OsLib.csproj')">..</RAIkeepRoot>
		<OsLibProjectPath Condition="'$(RAIkeepRoot)' != '' and Exists('$(RAIkeepRoot)/OsLib/OsLib.csproj')">$(RAIkeepRoot)/OsLib/OsLib.csproj</OsLibProjectPath>
		<RaiUtilsProjectPath Condition="'$(RAIkeepRoot)' != '' and Exists('$(RAIkeepRoot)/RaiUtils/RaiUtils.csproj')">$(RAIkeepRoot)/RaiUtils/RaiUtils.csproj</RaiUtilsProjectPath>
		<UseLocalRAIkeepSources Condition="'$(UseLocalRAIkeepSources)' == '' and '$(ContinuousIntegrationBuild)' == 'true'">false</UseLocalRAIkeepSources>
		<UseLocalRAIkeepSources Condition="'$(UseLocalRAIkeepSources)' == '' and '$(OsLibProjectPath)' != '' and '$(RaiUtilsProjectPath)' != ''">true</UseLocalRAIkeepSources>
		<UseLocalRAIkeepSources Condition="'$(UseLocalRAIkeepSources)' == ''">false</UseLocalRAIkeepSources>
		<OsLibPackageVersion Condition="'$(OsLibPackageVersion)' == ''">4.2.6</OsLibPackageVersion>
		<RaiUtilsPackageVersion Condition="'$(RaiUtilsPackageVersion)' == ''">4.2.6</RaiUtilsPackageVersion>
	</PropertyGroup>

	<Target Name="ValidateLocalRAIkeepSources"
		BeforeTargets="Restore"
		Condition="'$(UseLocalRAIkeepSources)' == 'true'">
		<Error Condition="'$(OsLibProjectPath)' == ''" Text="UseLocalRAIkeepSources=true requires an OsLib project checkout. Set /p:RAIkeepRoot=/path/to/RAIkeep." />
		<Error Condition="'$(RaiUtilsProjectPath)' == ''" Text="UseLocalRAIkeepSources=true requires a RaiUtils project checkout. Set /p:RAIkeepRoot=/path/to/RAIkeep." />
	</Target>

	<ItemGroup Condition="'$(UseLocalRAIkeepSources)' == 'true'">
		<ProjectReference Include="$(OsLibProjectPath)" />
		<ProjectReference Include="$(RaiUtilsProjectPath)" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseLocalRAIkeepSources)' != 'true'">
		<PackageReference Include="OsLibCore" Version="$(OsLibPackageVersion)" />
		<PackageReference Include="RaiUtils" Version="$(RaiUtilsPackageVersion)" />
	</ItemGroup>

</Project>
